# Local PostgreSQL (the dedicated CivicTrace container uses host port 5435)
POSTGRES_DB=civictrace
POSTGRES_USER=civictrace
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5435

# Backend
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/civictrace
SPRING_DATASOURCE_USERNAME=civictrace
SPRING_DATASOURCE_PASSWORD=change-me-local-only
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
APP_SEED_DEMO=true
DEMO_STAFF_EMAIL=staff@civictrace.local
DEMO_STAFF_PASSWORD=change-me-demo-only
DEMO_RESIDENT_EMAIL=resident@civictrace.local
DEMO_RESIDENT_PASSWORD=change-me-resident-only

# Frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
